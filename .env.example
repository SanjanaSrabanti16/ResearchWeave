# Optional. Unauthenticated Semantic Scholar access is supported but rate-limited.
SEMANTIC_SCHOLAR_API_KEY=
# Optional. OpenAlex works without a key; when set it is sent as api_key.
OPENALEX_API_KEY=
# Required only for DOI-based open-access lookup via the free Unpaywall API.
UNPAYWALL_EMAIL=
RANKING_PROFILE=fast
# Optional explicit overrides of the selected ranking profile:
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# RERANK_SHORTLIST_SIZE=100
# RANKING_FUSION_MODE=rrf  # Set to reranker to restore raw reranker ordering.
CACHE_TTL_HOURS=24
CANDIDATE_TARGET=240
# Optional local-only evidence extraction (Milestone 2B).
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434
# Docker Desktop backend reaches host Ollama through host.docker.internal.
# OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
# OLLAMA_TIMEOUT_SECONDS=180
# OLLAMA_BATCH_CHARS=13000
# INSIGHT_CACHE_DIR=./data/insights
# PDF processing defaults. GROBID runs locally; no hosted parser is required.
PDF_MAX_SIZE_MB=50
PDF_DOWNLOAD_TIMEOUT_SECONDS=30
# Optional comma-separated extension of/replacement for approved metadata PDF hosts.
# PDF_ALLOWED_HOSTS=arxiv.org,biorxiv.org,core.ac.uk,europepmc.org,hal.science,medrxiv.org,ncbi.nlm.nih.gov,openreview.net,osf.io,semanticscholar.org,zenodo.org
GROBID_URL=http://localhost:8070
GROBID_TIMEOUT_SECONDS=120
GROBID_PARSER_VERSION=0.9.0-crf
# PARSED_DOCUMENT_CACHE_DIR=./data/parsed_documents
