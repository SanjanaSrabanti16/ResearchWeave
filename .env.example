# ResearchWeave configuration template.
# Copy this file to .env. Empty optional values are safe and disable that integration.

# Core
RANKING_PROFILE=fast
CACHE_TTL_HOURS=24
CANDIDATE_TARGET=240
# DATABASE_URL=sqlite:///./data/cache.sqlite3
# PROVIDER_TIMEOUT_SECONDS=20
# PROVIDER_RETRIES=2
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# RERANK_SHORTLIST_SIZE=100
# RANKING_FUSION_MODE=rrf

# Scholarly providers (all optional; blank keys use public access where supported)
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
# Required only for DOI lookup through Unpaywall.
UNPAYWALL_EMAIL=

# Paper understanding (optional)
LLM_PROVIDER=ollama
# INSIGHT_CACHE_DIR=./data/insights
# LLM_DIAGNOSTIC_DIR=./data/llm_diagnostics

# Local Ollama (optional; Ollama runs separately from Docker Compose)
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
# OLLAMA_TIMEOUT_SECONDS=180
# OLLAMA_BATCH_CHARS=13000

# Google Gemini (optional cloud provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_SECONDS=180

# EVL Gemma / OpenAI-compatible endpoint (optional remote provider)
EVL_GEMMA_API_KEY=
EVL_GEMMA_BASE_URL=https://sage200.evl.uic.edu
EVL_GEMMA_MODEL=gemma4
# EVL_GEMMA_TIMEOUT_SECONDS=180

# PDF acquisition and local GROBID parsing (optional)
PDF_MAX_SIZE_MB=50
PDF_DOWNLOAD_TIMEOUT_SECONDS=30
# PDF_ALLOWED_HOSTS=arxiv.org,biorxiv.org,core.ac.uk,europepmc.org,hal.science,medrxiv.org,ncbi.nlm.nih.gov,openreview.net,osf.io,semanticscholar.org,zenodo.org
GROBID_URL=http://localhost:8070
GROBID_TIMEOUT_SECONDS=120
GROBID_PARSER_VERSION=0.9.1-crf+frontmatter-v1
# PARSED_DOCUMENT_CACHE_DIR=./data/parsed_documents

# Development
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
